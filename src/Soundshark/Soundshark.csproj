<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><RuntimeIdentifier>win-x64</RuntimeIdentifier><ApplicationIcon>../../assets/Soundshark.ico</ApplicationIcon><ApplicationManifest>app.manifest</ApplicationManifest><Version>1.9.1</Version></PropertyGroup>
  <ItemGroup><ProjectReference Include="../Soundshark.Core/Soundshark.Core.csproj"/><PackageReference Include="NAudio" Version="2.2.1"/><Resource Include="../../assets/shark.png" Link="Assets/shark.png"/><Content Include="../../tools/**/*" Link="Tools/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
  <PropertyGroup><AllowUnsafeBlocks>true</AllowUnsafeBlocks></PropertyGroup>
  <ItemGroup><Resource Include="../../assets/*.cur" Link="Assets/%(Filename)%(Extension)"/></ItemGroup>
<ItemGroup><Resource Include="../../assets/Fonts/*.ttf" Link="Assets/Fonts/%(Filename)%(Extension)"/><Content Include="../../assets/Fonts/*-OFL.txt" Link="Fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup><ItemGroup><Resource Include="../../assets/UpdateHistory.json" Link="Assets/UpdateHistory.json"/><Content Include="../../update-source.json" Link="update-source.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/><Content Include="../../scripts/Apply-AppUpdate.ps1" Link="Updater/Apply-AppUpdate.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup><ItemGroup><Content Include="../../hub-source.json" Link="hub-source.json" Condition="Exists('../../hub-source.json')" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup></Project>








